# Single or comma-separated multiple keys (automatically rotated on every search):
# DAHL_API_KEY="dahl_key1,dahl_key2,dahl_key3"
# Or numbered keys: DAHL_API_KEY_1="...", DAHL_API_KEY_2="...", ...
# Or place one key per line in a root `keys.txt` file.
AI_BASE_URL="https://inference.dahl.global/v1"
AI_MODEL="MiniMaxAI/MiniMax-M2.7"
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Takeads Server-to-Server Monetize API (Platform API Public Key from Platform settings -> Platform API)
TAKEADS_PUBLIC_KEY=
TAKEADS_SUB_ID="pezeex"
