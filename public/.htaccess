# Disable directory browsing across all folders
Options -Indexes

DirectoryIndex index.html index.php
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Block access to hidden directories like .git (allow .well-known/)
  RewriteRule (^|/)\.(?!well-known/) - [F,L]

  # 1. Serve Markdown when agents send Accept: text/markdown
  RewriteCond %{HTTP:Accept} text/markdown [NC]
  RewriteRule ^$ /index.md [L,T=text/markdown;charset=utf-8]
  RewriteCond %{HTTP:Accept} text/markdown [NC]
  RewriteRule ^about/?$ /about.md [L,T=text/markdown;charset=utf-8]
  RewriteCond %{HTTP:Accept} text/markdown [NC]
  RewriteRule ^contact/?$ /contact.md [L,T=text/markdown;charset=utf-8]
  RewriteCond %{HTTP:Accept} text/markdown [NC]
  RewriteRule ^privacy(?:-policy)?/?$ /privacy-policy.md [L,T=text/markdown;charset=utf-8]
  RewriteCond %{HTTP:Accept} text/markdown [NC]
  RewriteRule ^terms(?:-of-use)?/?$ /terms-of-use.md [L,T=text/markdown;charset=utf-8]

  # 2. Route API requests directly to PHP scripts (including live SSE streaming)
  RewriteRule ^api/search-stream/?$ api/search.php?stream=1 [L,QSA]
  RewriteRule ^api/search/?$ api/search.php [L,QSA]
  RewriteRule ^api/location/?$ api/location.php [L,QSA]
  RewriteRule ^api/health/?$ api/health.php [L,QSA]

  # 3. Rewrite ONLY known SPA routes to index.html so missing URLs return a real HTTP 404
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(?:about|contact|privacy(?:-policy)?|terms(?:-of-use)?)/?$ /index.html [L]
</IfModule>

# Disable proxy/gzip buffering on live SSE search stream so batches flush immediately
<IfModule mod_setenvif.c>
  SetEnvIfNoCase Request_URI "^/api/search-stream" no-gzip=1 dont-vary=1
</IfModule>

# Block direct public access to sensitive config, env, key, backup, source, and build files (LiteSpeed safe)
<FilesMatch "^(\.env(\..*)?|\.keys|\.htaccess|\.htpasswd|config(\.example)?\.php|keys\.txt|server\.(cjs|ts|js)|serverUrlAnalyzer\.ts|serverAgentReady\.ts|serverTakeads\.ts|vite\.config\.ts|tsconfig\.json|package(-lock)?\.json|composer\.(json|lock)|bun\.lock|components\.json|metadata\.json|download_logos\.ts|updateTranslations\.js|test-litb\.js|add-reddit\.cjs)$|\.(log|bak|sql|sh|map|cjs|orig|swp)$">
  Require all denied
</FilesMatch>

# Security Headers and RFC 8288 Link Discovery Headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
  Header always set X-Permitted-Cross-Domain-Policies "none"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" "expr=%{HTTPS} == 'on'"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://convertlink.com https://*.convertlink.com https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' https://www.google.com https://icons.duckduckgo.com https://*.gstatic.com data: blob:; connect-src 'self' https://get.geojs.io https://convertlink.com https://*.convertlink.com; base-uri 'self'; object-src 'none'; form-action 'self'; frame-ancestors 'self'"

  <FilesMatch "^(index\.html|index\.md)$">
    Header always set Vary "Accept"
    Header always set Link "<https://pezeex.com/llms.txt>; rel=\"describedby\"; type=\"text/plain\", <https://pezeex.com/index.md>; rel=\"alternate\"; type=\"text/markdown\", <https://pezeex.com/.well-known/mcp/server-card.json>; rel=\"service-desc\"; type=\"application/json\", <https://pezeex.com/sitemap.xml>; rel=\"sitemap\"; type=\"application/xml\""
  </FilesMatch>
</IfModule>

# MIME types
<IfModule mod_mime.c>
  AddType application/javascript .js
  AddType text/css .css
  AddType application/json .json
  AddType application/xml .xml
  AddType text/plain .txt
  AddType text/markdown .md
  AddType image/svg+xml .svg
  AddType application/manifest+json .webmanifest
</IfModule>
