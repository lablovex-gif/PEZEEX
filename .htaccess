# =============================================================
# If setting Environment Variable via .htaccess on your host:
# SetEnv GEMINI_API_KEY your_api_key_here
# =============================================================

DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Route API requests directly to PHP scripts
  RewriteRule ^api/search/?$ api/search.php [L,QSA]
  RewriteRule ^api/health/?$ api/health.php [L,QSA]

  # 2. Block direct access to .git and scripts directories if present
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteRule (^|/)\.git(/|$) - [F,L]
  RewriteRule ^scripts(/|$) - [F,L]

  # 3. Standard Vite React Single Page Application (SPA) routing
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# Block direct public access to sensitive config, env, key, and source files (LiteSpeed & Apache safe)
<FilesMatch "(^\.|^config(\.example)?\.php$|^keys\.txt$|^server\.(cjs|ts)$|^vite\.config\.ts$|^tsconfig\.json$|^package(-lock)?\.json$|^bun\.lock$|^components\.json$|^metadata\.json$|^add-reddit\.cjs$|^download_logos\.ts$|^test-litb\.js$|^updateTranslations\.js$|\.(env|log|bak|old|sql|sh|ts|tsx|cjs|map|md)$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Security Headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
  Header always set X-Permitted-Cross-Domain-Policies "none"
</IfModule>

# MIME types
<IfModule mod_mime.c>
  AddType application/javascript .js
  AddType text/css .css
  AddType application/json .json
  AddType image/svg+xml .svg
  AddType application/manifest+json .webmanifest
</IfModule>

# Security: Disable directory listing
Options -Indexes
